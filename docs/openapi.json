{
  "openapi": "3.0.3",
  "info": {
    "title": "Portfolio API",
    "version": "1.2.0",
    "description": "portfolio-api. Public: GET /content, POST /views. Admin routes need a Cognito access token (OAuth2 authorization code + PKCE). In Bruno, use the cognito auth on admin requests and set the callback URL to http://localhost:5173/admin."
  },
  "servers": [
    {
      "url": "https://fb769umpf4.execute-api.ca-central-1.amazonaws.com",
      "description": "prod"
    }
  ],
  "paths": {
    "/content": {
      "get": {
        "summary": "Get all site content",
        "operationId": "getContent",
        "responses": {
          "200": {
            "description": "Profile, projects and experience, each list sorted by order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Content"
                }
              }
            }
          }
        }
      }
    },
    "/views": {
      "post": {
        "summary": "Increment the page view counter",
        "operationId": "incrementViews",
        "description": "Atomically adds 1 to COUNTER/VIEWS and returns the new count.",
        "responses": {
          "200": {
            "description": "New view count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "views": {
                      "type": "integer",
                      "example": 3174
                    }
                  },
                  "required": [
                    "views"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/items/{type}/{id}": {
      "parameters": [
        {
          "name": "type",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "profile",
              "project",
              "experience"
            ]
          },
          "description": "profile is a single item, so its id is ignored (use any value, e.g. me)"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "example": "airbnb-clone"
          }
        }
      ],
      "put": {
        "summary": "Create or replace a content item",
        "operationId": "putItem",
        "security": [
          {
            "cognito": [
              "openid",
              "email"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "title": "New Project",
                "summary": "One-line summary",
                "body": "Long description",
                "tech": [
                  "React",
                  "AWS"
                ],
                "images": [],
                "github": "",
                "liveUrl": "",
                "order": 12,
                "featured": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      },
      "delete": {
        "summary": "Delete a content item",
        "operationId": "deleteItem",
        "security": [
          {
            "cognito": [
              "openid",
              "email"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "summary": "Get a presigned S3 POST for a PDF or image (max 10 MB)",
        "operationId": "createUpload",
        "security": [
          {
            "cognito": [
              "openid",
              "email"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "filename",
                  "contentType"
                ],
                "properties": {
                  "filename": {
                    "type": "string",
                    "example": "resume.pdf"
                  },
                  "contentType": {
                    "type": "string",
                    "enum": [
                      "application/pdf",
                      "image/png",
                      "image/jpeg",
                      "image/webp",
                      "image/gif"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "POST the file as multipart form data to url with fields, then store key on the item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "example": "media/0f1e.../resume.pdf"
                    },
                    "url": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/login": {
      "servers": [
        {
          "url": "https://cognito-idp.ca-central-1.amazonaws.com",
          "description": "Cognito (not the portfolio API)"
        }
      ],
      "post": {
        "summary": "Log in and get an access token (Cognito InitiateAuth)",
        "description": "This is Cognito's own API, not the portfolio API. The real path is / ; Bruno shows it as /login. If the import keeps /login, change the URL to https://cognito-idp.ca-central-1.amazonaws.com/ . Use AuthenticationResult.AccessToken as the Bearer token on admin requests. On first login Cognito returns ChallengeName NEW_PASSWORD_REQUIRED instead: set your password once through the hosted login page, then this works.",
        "operationId": "login",
        "parameters": [
          {
            "name": "X-Amz-Target",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "AWSCognitoIdentityProviderService.InitiateAuth"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-amz-json-1.1": {
              "schema": {
                "type": "object"
              },
              "example": {
                "AuthFlow": "USER_PASSWORD_AUTH",
                "ClientId": "3csaagvn6ld18gnjlbt1eeaq1f",
                "AuthParameters": {
                  "USERNAME": "ryanlepham9@gmail.com",
                  "PASSWORD": "your-password"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens",
            "content": {
              "application/x-amz-json-1.1": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "AuthenticationResult": {
                    "AccessToken": "eyJ...",
                    "ExpiresIn": 3600,
                    "TokenType": "Bearer",
                    "IdToken": "eyJ...",
                    "RefreshToken": "eyJ..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "NotAuthorizedException: wrong email or password"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Content": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "experience": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "profile",
          "projects",
          "experience"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "cognito": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://ryanlepham-portfolio.auth.ca-central-1.amazoncognito.com/oauth2/authorize",
            "tokenUrl": "https://ryanlepham-portfolio.auth.ca-central-1.amazoncognito.com/oauth2/token",
            "scopes": {
              "openid": "OpenID",
              "email": "Email"
            }
          }
        }
      }
    }
  }
}
