{
  "openapi": "3.0.3",
  "info": {
    "title": "Portfolio API",
    "version": "1.3.0",
    "description": "portfolio-api. Public: GET /content, POST /views, POST /login. Admin routes need the accessToken from POST /login as a Bearer token (or a token from the Cognito hosted login, OAuth2 code + PKCE)."
  },
  "servers": [
    {
      "url": "https://fb769umpf4.execute-api.ca-central-1.amazonaws.com",
      "description": "prod"
    }
  ],
  "paths": {
    "/content": {
      "get": {
        "summary": "Get all site content",
        "operationId": "getContent",
        "responses": {
          "200": {
            "description": "Profile, projects and experience, each list sorted by order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Content"
                }
              }
            }
          }
        }
      }
    },
    "/views": {
      "post": {
        "summary": "Increment the page view counter",
        "operationId": "incrementViews",
        "description": "Atomically adds 1 to COUNTER/VIEWS and returns the new count.",
        "responses": {
          "200": {
            "description": "New view count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "views": {
                      "type": "integer",
                      "example": 3174
                    }
                  },
                  "required": [
                    "views"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/items/{type}/{id}": {
      "parameters": [
        {
          "name": "type",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "profile",
              "project",
              "experience"
            ]
          },
          "description": "profile is a single item, so its id is ignored (use any value, e.g. me)"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "example": "airbnb-clone"
          }
        }
      ],
      "put": {
        "summary": "Create or replace a content item",
        "operationId": "putItem",
        "security": [
          {
            "cognito": [
              "openid",
              "email"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "title": "New Project",
                "summary": "One-line summary",
                "body": "Long description",
                "tech": [
                  "React",
                  "AWS"
                ],
                "images": [],
                "github": "",
                "liveUrl": "",
                "order": 12,
                "featured": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      },
      "delete": {
        "summary": "Delete a content item",
        "operationId": "deleteItem",
        "security": [
          {
            "cognito": [
              "openid",
              "email"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "summary": "Get a presigned S3 POST for a PDF or image (max 10 MB)",
        "operationId": "createUpload",
        "security": [
          {
            "cognito": [
              "openid",
              "email"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "filename",
                  "contentType"
                ],
                "properties": {
                  "filename": {
                    "type": "string",
                    "example": "resume.pdf"
                  },
                  "contentType": {
                    "type": "string",
                    "enum": [
                      "application/pdf",
                      "image/png",
                      "image/jpeg",
                      "image/webp",
                      "image/gif"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "POST the file as multipart form data to url with fields, then store key on the item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "example": "media/0f1e.../resume.pdf"
                    },
                    "url": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid type, id or body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Log in and get an access token",
        "description": "Exchanges your Cognito email + password for a 1-hour access token. Send it as 'Authorization: Bearer <accessToken>' on admin requests. Rate limited to 1 request/sec (burst 5). Returns 403 until you've replaced the emailed temporary password on the hosted login page.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              },
              "example": {
                "email": "ryanlepham9@gmail.com",
                "password": "your-password"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "example": 3600
                    },
                    "tokenType": {
                      "type": "string",
                      "example": "Bearer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password"
          },
          "401": {
            "description": "Incorrect email or password"
          },
          "403": {
            "description": "Password change still required"
          },
          "429": {
            "description": "Too many attempts"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Content": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "experience": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "profile",
          "projects",
          "experience"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "cognito": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://ryanlepham-portfolio.auth.ca-central-1.amazoncognito.com/oauth2/authorize",
            "tokenUrl": "https://ryanlepham-portfolio.auth.ca-central-1.amazoncognito.com/oauth2/token",
            "scopes": {
              "openid": "OpenID",
              "email": "Email"
            }
          }
        }
      }
    }
  }
}
